{
  "name": "curbside-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Provider-pluggable grocery CLI. Authenticate once, then drive curbside/delivery carts from the terminal — no browser after auth.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "oxlint && tsc -b && prettier --check .",
    "curbside": "node packages/cli/dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
