{
  "name": "curbside",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-pluggable grocery CLI. Authenticate once, then drive curbside/delivery carts from the terminal — no browser after auth. First provider: H-E-B.",
  "type": "module",
  "bin": {
    "curbside": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "curbside": "node --experimental-strip-types src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --experimental-strip-types src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
